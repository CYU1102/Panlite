{
  "name": "panlite",
  "version": "0.2.0",
  "description": "PanLite - 网盘管理工具",
  "license": "MIT",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.node.json --watch\" \"node scripts/wait-and-start.js\"",
    "build": "npm run typecheck && vite build && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json --noEmit && node scripts/build-main.mjs",
    "pack": "npm run build && electron-builder --win",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run build:main && npm test",
    "size:report": "node scripts/report-package-size.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "better-sqlite3": "^11.8.1",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2",
    "pdf2json": "^4.0.3",
    "tar": "^7.4.3",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "cheerio": "^1.0.0-rc.12",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "electron-log": "^5.3.3",
    "element-plus": "^2.9.7",
    "esbuild": "^0.25.12",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "lucide-vue-next": "^0.474.0",
    "p-queue": "^6.6.2",
    "pinia": "^3.0.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "uuid": "^11.1.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.8"
  }
}
