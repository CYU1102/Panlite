{
  "name": "panlite",
  "version": "0.2.3-rc.1",
  "description": "PanLite - 网盘管理工具",
  "license": "MIT",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.node.json --watch --noEmit\" \"node scripts/wait-and-start.js\"",
    "predev": "npm run rebuild:electron",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main",
    "build:renderer": "vite build && npm run size:renderer",
    "build:main": "tsc -p tsconfig.node.json --noEmit && node scripts/build-main.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "pack": "npm run build && electron-builder --win --publish never",
    "prepack": "npm run rebuild:electron",
    "pack:release": "npm run build && electron-builder --win --config electron-builder.release.cjs --publish never",
    "prepack:release": "npm run rebuild:electron",
    "release:verify": "powershell -NoProfile -File scripts/verify-release.ps1",
    "test:install": "powershell -NoProfile -File scripts/smoke-install.ps1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "pretest": "npm run rebuild:node",
    "test": "vitest run --maxWorkers=4",
    "test:preview": "node scripts/smoke-preview.mjs",
    "test:ocr:accuracy": "node scripts/verify-ocr-accuracy.mjs",
    "test:task-coverage": "npm run rebuild:node && vitest run src/main/task-state-machine.test.ts --coverage",
    "rebuild:node": "node scripts/rebuild-native.mjs node",
    "rebuild:electron": "node scripts/rebuild-native.mjs electron",
    "check": "npm run lint && npm run typecheck && npm run build:renderer && npm run build:main && npm test",
    "security:audit": "npm audit --audit-level=high",
    "size:report": "node scripts/report-package-size.mjs",
    "size:renderer": "node scripts/report-renderer-size.mjs",
    "checksums": "node scripts/write-checksums.mjs",
    "benchmark:startup": "npm run rebuild:electron && node scripts/benchmark-startup.mjs",
    "benchmark:transfer": "node scripts/benchmark-transfer.mjs",
    "release:notes": "node scripts/write-release-notes.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "7zip-bin": "^5.2.0",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "6.8.9",
    "js-yaml": "4.3.2",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2",
    "pdf2json": "^4.0.3",
    "sax": "1.6.1",
    "tar": "^7.4.3",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@element-plus/icons-vue": "^2.3.1",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.0",
    "cheerio": "^1.0.0-rc.12",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.3.3",
    "element-plus": "^2.9.7",
    "esbuild": "^0.25.12",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "lucide-vue-next": "^0.474.0",
    "p-queue": "^6.6.2",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^3.0.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "unplugin-vue-components": "^32.1.0",
    "uuid": "^11.1.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.8"
  },
  "author": {
    "name": "CYU1102",
    "url": "https://github.com/CYU1102"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24",
    "npm": ">=10"
  }
}
